# Copy to .env, keep it private, and replace ALL example addresses.
# DNS A records: sofa.example.net and turn.example.net -> your public IPv4.
SOFA_DOMAIN=sofa.example.net
TURN_DOMAIN=turn.example.net
ACME_EMAIL=you@example.net

# Empty on purpose: Compose refuses to run without real secrets.
# Generate TWO DIFFERENT random values using: openssl rand -hex 32
ROOM_SECRET=
TURN_SECRET=

# Documentation-only IPv4: replace this! Public and local interface addresses
# are equal on a server directly assigned its public IP. Behind 1:1 NAT,
# LISTEN is the server's local interface IPv4; PUBLIC is the external IPv4.
TURN_PUBLIC_IP=203.0.113.10
TURN_LISTEN_IP=203.0.113.10
